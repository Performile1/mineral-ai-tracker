# Mineral AI Tracker - Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Choose: "local" for Docker PostgreSQL or "supabase" for Supabase Cloud
NEXT_PUBLIC_DATABASE_TYPE=local

# Supabase Configuration (only if using Supabase Cloud)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# API CONFIGURATION
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# ENVIRONMENT
# ============================================================================
NEXT_PUBLIC_ENVIRONMENT=development
