# Mineral AI Tracker - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Choose: "local" for Docker PostgreSQL or "supabase" for Supabase Cloud
DATABASE_TYPE=local

# Local PostgreSQL Configuration (for Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mineral_user
POSTGRES_PASSWORD=mineral_password
POSTGRES_DB=mineral_ai_tracker

# Supabase Configuration (optional, if using Supabase Cloud)
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# TWILIO SMS NOTIFICATIONS
# ============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ============================================================================
# PROXY CONFIGURATION (Optional)
# ============================================================================
# PROXY_LIST=http://proxy1.example.com:8080,http://proxy2.example.com:8080

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
PROXY_ROTATION_ENABLED=true
MAX_RETRIES=3
REQUEST_TIMEOUT=30
RATE_LIMIT_ENABLED=true
REQUESTS_PER_MINUTE=60
REQUESTS_PER_HOUR=1000

# ============================================================================
# SCRAPING SCHEDULE
# ============================================================================
FINANCE_SCRAPER_INTERVAL_MINUTES=5
GOVERNMENT_SCRAPER_HOUR=2
SENTIMENT_SCRAPER_INTERVAL_HOURS=6

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Stripe (PRD 5.0)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
DEBUG=false
